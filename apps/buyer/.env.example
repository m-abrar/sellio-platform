# Local dev: Laravel API base URL (direct — buyer dev server has no /api proxy)
VITE_API_URL=http://127.0.0.1:8000/api
VITE_STOREFRONT_URL=http://localhost:3000

# Real-time (Pusher) — copy from apps/backend/.env.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1

# Production: edit public/config.js on the server (no rebuild).
# VITE_* below is only for local dev / CI builds.
