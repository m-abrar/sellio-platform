APP_NAME=Sellio
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
STOREFRONT_URL=
ADMIN_APP_URL=
SELLER_APP_URL=
BUYER_APP_URL=
# Optional .env fallback for CORS (primary control: Admin → Settings → General → API CORS Origins)
CORS_ALLOWED_ORIGINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Recommended: mysql or pgsql
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sellio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Set to "pusher" in production/staging to enable real-time broadcasting.
# Leave as "log" for local development (events are written to laravel.log instead).
BROADCAST_CONNECTION=log

# Pusher credentials — required when BROADCAST_CONNECTION=pusher.
# Create a free app at https://pusher.com and copy the keys here.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# Vite exposes these to the frontend Echo client (apps/backend/resources/js/echo.js).
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
# Google Maps — enables the drag-and-drop location picker on property and event create/edit pages.
# Create a key at https://console.cloud.google.com (enable Maps JavaScript API).
# Alternatively, set google_map_api_key via Admin → Settings in the dashboard.
GOOGLE_MAPS_API_KEY=

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@sellio.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Optional: pre-seed Stripe sandbox credentials on migrate:fresh --seed
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=USD
