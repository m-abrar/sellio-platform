# Local dev: same-origin /api (Vite proxies to Laravel — see vite.config.ts)
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Real-time (Pusher) — copy from apps/backend/.env.
# Leave blank to disable WebSocket connections (graceful no-op).
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1

# Production: buyers edit public/config.js on the server (no rebuild).
# VITE_API_URL below is only for local dev / CI builds.
