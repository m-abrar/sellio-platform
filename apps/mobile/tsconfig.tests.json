{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2020",
    "types": ["node"],
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": [
    "src/features/auth/types.ts",
    "src/features/listings/types.ts",
    "src/features/buyer/types.ts",
    "src/features/buyer/adapters.ts",
    "src/api/errors.ts",
    "src/auth/buyerAccess.ts",
    "src/auth/sessionCodec.ts",
    "src/validation/auth.ts",
    "src/components/states/stateModel.ts",
    "tests/**/*.ts"
  ]
}
