{
  "expo": {
    "name": "Sellio",
    "slug": "sellio",
    "scheme": "sellio",
    "version": "2.4.0",
    "orientation": "portrait",
    "icon": "./assets/sellio-icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/sellio-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070708"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sellio.marketplace",
      "buildNumber": "1"
    },
    "android": {
      "usesCleartextTraffic": true,
      "package": "com.sellio.marketplace",
      "versionCode": 1,
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/sellio-icon.png",
        "backgroundColor": "#070708"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Sellio to choose a profile photo."
        }
      ],
      "expo-web-browser"
    ]
  }
}
